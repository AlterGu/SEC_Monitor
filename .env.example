# ============================================================
# Telegram
# ============================================================
# 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ============================================================
# OpenAI (支持第三方兼容 API)
# ============================================================
OPENAI_API_KEY=your-openai-api-key-here
# 留空使用 OpenAI 官方, 第三方填如 https://api.siliconflow.cn/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# SEC EDGAR
# ============================================================
# 检查间隔(分钟)
DEFAULT_INTERVAL_MINUTES=60
# SEC 要求的 User-Agent, 必须包含联系方式
USER_AGENT=SEC Monitor Bot (your-email@example.com)

# ============================================================
# 数据库 (默认 SQLite, 无需额外配置)
# ============================================================
DB_BACKEND=sqlite
DB_PATH=data/sec_monitor.db

# ============================================================
# Supabase (仅 DB_BACKEND=supabase 时需要)
# ============================================================
# 项目 URL: Dashboard > Settings > API > Project URL
# 格式: https://xxxxx.supabase.co  (https 开头, 不是 PostgreSQL 地址!)
SUPABASE_URL=
# service_role key: Dashboard > Settings > API > Project API keys > service_role
SUPABASE_KEY=
# PostgreSQL 直连地址 (可选, 用于启动时自动建表)
# 格式: postgresql://postgres.xxxxx:password@aws-xx-xx-xx-x.pooler.supabase.com:5432/postgres
# 获取: Dashboard > Settings > Database > Connection string > URI
SUPABASE_DB_URL=

# ============================================================
# 访问控制 (可选)
# ============================================================
# 白名单: 逗号分隔的 Telegram user ID, 填了则不需要密码
ALLOWED_USER_IDS=
# 访问密码: 未设白名单时, 用户需输入此密码
ACCESS_PASSWORD=
